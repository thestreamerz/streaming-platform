rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin function - check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@thestreamerz.com';
    }
    
    // Users can read and write their own data, admins can read all
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Watchlists - users can manage their own
    match /watchlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User ratings and reviews
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Watch history - users can read/write their own
    match /watchHistory/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Ad tracking collections - allow all writes for analytics (anonymous users too)
    match /adImpressions/{impressionId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adClicks/{clickId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adConversions/{conversionId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adDailyStats/{statsId} {
      allow read, write: if true; // Allow stats updates
    }
    
    match /adSessions/{sessionId} {
      allow read, write: if true; // Allow session tracking
    }
    
    // Custom content management (for CMS) - admin only write access
    match /customContent/{contentId} {
      allow read: if true; // Anyone can read custom content
      allow write: if isAdmin(); // Only admin can write
    }
    
    // Streaming servers management - admin only write access
    match /streamingServers/{serverId} {
      allow read: if true; // Anyone can read server info
      allow write: if isAdmin(); // Only admin can manage servers
    }
    
    // Site settings and configuration - admin only write access
    match /siteSettings/{settingId} {
      allow read: if true; // Anyone can read settings
      allow write: if isAdmin(); // Only admin can modify settings
    }
    
    // Public movie/show data (read-only)
    match /movies/{movieId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /shows/{showId} {
      allow read: if true;
      allow write: if false;
    }
  }
}