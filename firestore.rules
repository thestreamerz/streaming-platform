rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User watch history and stats
    match /userWatchHistory/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /userStats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ad analytics (public read, authenticated write)
    match /adAnalytics/{analyticsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Ad tracking collections - allow all writes for analytics (anonymous users too)
    match /adImpressions/{impressionId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adClicks/{clickId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adConversions/{conversionId} {
      allow read, write: if true; // Allow anonymous tracking
    }
    
    match /adDailyStats/{statsId} {
      allow read, write: if true; // Allow stats updates
    }
    
    match /adSessions/{sessionId} {
      allow read, write: if true; // Allow session tracking
    }
  }
}